{
  "rewrites": [
    {
      "source": "/games/(.*)",
      "destination": "/games/$1"
    },
    {
      "source": "/sublevel-studio/(.*)",
      "destination": "/sublevel-studio/$1"
    },
    {
      "source": "/landing-pages/(.*)",
      "destination": "/landing-pages/$1"
    },
    {
      "source": "/secret-pathways-assets/(.*)",
      "destination": "/secret-pathways-assets/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
